# Copy this file to ".env" (same folder) and put your real keys there.
# .env is in .gitignore, so your keys never go to GitHub. This example file does.
PIXABAY_API_KEY=your-pixabay-api-key-here
# Product Hunt developer token (step 1, Startup of the Day): producthunt.com/v2/oauth/applications
PRODUCTHUNT_TOKEN=your-producthunt-developer-token-here
